# MongoDB (required): accounts, sessions, wallets, the contact inbox and billboard
# bookings (ad media is stored in GridFS). Put the database name in the path.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.example.net/arcade3d?retryWrites=true&w=majority"

# Stripe (optional): gold packs and billboard bookings. Without these keys the
# checkout routes answer with an error and the rest of the game still works.
# Use test keys (sk_test_...) until you are ready to take real payments.
STRIPE_SECRET_KEY=""
# Signing secret of your webhook endpoint pointed at /api/stripe/webhook
# (event: checkout.session.completed). Gold and bookings are credited from it.
STRIPE_WEBHOOK_SECRET=""

# Comma-separated usernames that get /admin and every item unlocked.
# Empty: nobody is an admin.
ADMIN_USERNAMES=""

# Port for `npm start` (server/prod.mjs: web + multiplayer relay at /mp). Default 3000.
PORT=3000
# Port of the standalone multiplayer relay used by `npm run dev`. Default 8031.
MP_PORT=8031
